# Python
__pycache__/
*.py[oc]
*.egg-info/
build/
dist/
wheels/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/

# Generated submission outputs
generate/**/*.fasta
generate/**/*.partial.fasta
generate/**/*.stats.json
generate/run.json
generate/config.resolved.yaml
generate/length_histogram.png

# Models & predictions
!models/.gitkeep

# Processed binary/feature dumps (ESM-2 embeddings, etc.)
data/processed/*.npy
data/processed/*.npz
!data/processed/.gitkeep

# Local envs & overrides
.env
*.local.yaml
*.local.json

# Runtime logs & background outputs
*.log
logs/
nohup.out
.pytest_cache/

# Large model artifacts — keep directory structure, not weights
checkpoint/*
!checkpoint/.gitkeep
!checkpoint/lora_antibacterial/
checkpoint/lora_antibacterial/last/
!checkpoint/lora_cond_v2/
checkpoint/lora_cond_v2/last/
*.safetensors
!checkpoint/lora_antibacterial/best/adapter_model.safetensors
!checkpoint/lora_cond_v2/best/adapter_model.safetensors
*.bin
*.pt
!checkpoint/lora_cond_v2/best/conditioner.pt
*.ckpt
*.h5

# Data dumps (commit small samples and READMEs only)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep
!data/external/antibacterial.manifest.json
!data/external/antibacterial.fasta
data/external/uniprot_putative_nonamp_raw.fasta.gz

# Notebooks / experiment clutter
.ipynb_checkpoints/
wandb/
runs/
outputs/
lightning_logs/

# OS / editors
.DS_Store
.idea/
.vscode/
